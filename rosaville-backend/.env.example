DJANGO_SECRET_KEY=change-me
# Defaults to false (production-safe) if unset. Set to true for local dev.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Either set DATABASE_URL, or the individual DB_* vars below.
# For Supabase specifically: use the "Session pooler" connection string
# (Project > Connect), NOT "Direct connection" — direct connections resolve
# to an IPv6-only address that many hosts/networks can't route to. If the
# password has special characters, they must be percent-encoded (e.g. "!" ->
# "%21") — the settings.py parser correctly decodes this back before use.
# DATABASE_URL=postgres://user:password@host:5432/dbname
DB_NAME=rosaville
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Comma-separated list of frontend origins allowed to call this API.
# Must be https:// for anything other than local dev.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

ADMIN_SEED_EMAIL=admin@rosaville.local
ADMIN_SEED_PASSWORD=changeme123

# Media storage: leave unset for local dev (uploads go to local disk).
# Set all of these in production (e.g. Supabase Storage's S3-compatible API)
# so uploads survive redeploys. Create the bucket as PUBLIC in Supabase's
# Storage UI first, and generate S3 access keys from Storage > S3 Access Keys
# (endpoint shown there is the *.storage.supabase.co host, used only for
# uploads — it 403s on plain reads, that's expected).
# SUPABASE_S3_BUCKET=rosaville-media
# SUPABASE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# SUPABASE_S3_ACCESS_KEY=
# SUPABASE_S3_SECRET_KEY=
# SUPABASE_S3_REGION=us-east-1
# SUPABASE_URL is the project's *main* URL (Project Settings > General, or
# shown at the top of the project dashboard — e.g. https://<project-ref>.supabase.co,
# NOT the storage.supabase.co endpoint above). Required alongside the S3_*
# vars — without it, uploads succeed but the URLs saved to the database
# point at the S3 endpoint, which rejects public reads with 403.
# SUPABASE_URL=https://<project-ref>.supabase.co

# Brevo (ex-Sendinblue) newsletter sync: leave BREVO_API_KEY unset to skip
# syncing entirely — subscribers still get saved to our own DB either way.
# Get an API key at app.brevo.com > Settings > SMTP & API > API Keys, and
# a list ID from Contacts > Lists (optional — omit to add contacts with no list).
# BREVO_API_KEY=
# BREVO_LIST_ID=

# Transactional email (password resets, staff temp-password delivery). Leave
# EMAIL_HOST unset for local dev — mail prints to the runserver console
# instead of sending. In production, Brevo's SMTP relay works with the same
# account as BREVO_API_KEY above (smtp-relay.brevo.com, port 587) — the
# Login/SMTP-key pair shown on Settings > SMTP & API > SMTP (the login looks
# like a generated address, e.g. xxxxx@smtp-brevo.com — NOT your actual
# Brevo account email; the SMTP key is a separate value from the API key
# above), or use any other SMTP provider.
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL must be a sender VERIFIED in Brevo (Settings > Senders,
# Domains & Dedicated IPs > Senders) — Brevo silently rejects sends from any
# other address ("sender ... is not valid"), a real gotcha hit during setup.
# DEFAULT_FROM_EMAIL=no-reply@rosaville.com

# Base URLs of the two frontends — used to build links in password-reset
# emails (customers get a FRONTEND_URL link, staff get a DASHBOARD_URL link).
FRONTEND_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5174
