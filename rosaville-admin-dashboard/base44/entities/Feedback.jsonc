{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 5
    },
    "message": {
      "type": "string"
    },
    "dessert_name": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "Website",
        "Email",
        "Google",
        "Facebook",
        "Instagram"
      ],
      "default": "Website"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Reviewed",
        "Featured",
        "Archived"
      ],
      "default": "New"
    }
  },
  "required": [
    "customer_name"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "employee"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    }
  }
}